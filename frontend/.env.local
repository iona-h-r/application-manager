# Vite 環境変数（VITE_ プレフィックスが必須）
# このファイルをコピーして .env.local を作成してください
# cp .env.example .env.local

# API Gateway エンドポイント
# ローカル(SAM): http://localhost:3002/local
# 本番: terraform output api_endpoint の値
VITE_API_BASE_URL=http://localhost:3002

# Cognito 設定（本番のみ使用。ローカルはダミーでOK）
VITE_COGNITO_REGION=ap-northeast-1
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

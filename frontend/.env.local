# Vite 環境変数（VITE_ プレフィックスが必須）
# このファイルをコピーして .env.local を作成してください
# cp .env.example .env.local

# API Gateway エンドポイント
# ローカル(SAM): http://localhost:3002
# 本番: terraform output api_endpoint の値
VITE_API_BASE_URL=http://localhost:3000

# Cognito 設定（sam deploy 後に Outputs の値を設定）
VITE_COGNITO_REGION=ap-northeast-1
VITE_USER_POOL_ID=ap-northeast-1_0gKAAiZMq
VITE_USER_POOL_CLIENT_ID=2o600nc9r6efet53t4r18acgp5
